# =========================================================================
# Wishlist Re-engagement Engine Config Example
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' containing real secrets to version control.
# =========================================================================

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Redis State Store Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=wishlist-reengagement-group
